  "constraints": [
    {
      "table_name": "vertice_data_connections",
      "conname": "vertice_data_connections_escopo_check",
      "definition": "CHECK ((escopo = ANY (ARRAY['agregado'::text, 'nominal'::text])))"
    },
    {
      "table_name": "vertice_data_connections",
      "conname": "vertice_data_connections_escopo_financeiro_check",
      "definition": "CHECK ((escopo_financeiro = ANY (ARRAY['nenhum'::text, 'pessoal'::text, 'completo'::text])))"
    },
    {
      "table_name": "vertice_data_connections",
      "conname": "vertice_data_connections_fornecedor_check",
      "definition": "CHECK (((char_length(fornecedor) >= 2) AND (char_length(fornecedor) <= 60)))"
    },
    {
      "table_name": "vertice_data_connections",
      "conname": "vertice_data_connections_institution_id_fkey",
      "definition": "FOREIGN KEY (institution_id) REFERENCES vertice_institutions(id) ON DELETE CASCADE"
    },
    {
      "table_name": "vertice_data_connections",
      "conname": "vertice_data_connections_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "vertice_data_connections",
      "conname": "vertice_data_connections_rotulo_check",
      "definition": "CHECK (((char_length(rotulo) >= 2) AND (char_length(rotulo) <= 80)))"
    },
    {
      "table_name": "vertice_data_connections",
      "conname": "vertice_data_connections_status_check",
      "definition": "CHECK ((status = ANY (ARRAY['pendente'::text, 'aguardando_aprovacao'::text, 'ativa'::text, 'erro'::text, 'pausada'::text])))"
    },
    {
      "table_name": "vertice_data_connections",
      "conname": "vertice_data_connections_tipo_check",
      "definition": "CHECK ((tipo = ANY (ARRAY['api'::text, 'sql'::text, 'agente'::text, 'onedrive'::text])))"
    },
    {
      "table_name": "vertice_data_connection_runs",
      "conname": "vertice_data_connection_runs_acao_check",
      "definition": "CHECK ((acao = ANY (ARRAY['criar'::text, 'testar'::text, 'sincronizar'::text, 'pausar'::text, 'retomar'::text, 'revogar'::text, 'aprovar'::text])))"
    },
    {
      "table_name": "vertice_data_connection_runs",
      "conname": "vertice_data_connection_runs_connection_id_fkey",
      "definition": "FOREIGN KEY (connection_id) REFERENCES vertice_data_connections(id) ON DELETE CASCADE"
    },
    {
      "table_name": "vertice_data_connection_runs",
      "conname": "vertice_data_connection_runs_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "vertice_data_connection_runs",
      "conname": "vertice_data_connection_runs_status_check",
      "definition": "CHECK ((status = ANY (ARRAY['ok'::text, 'erro'::text])))"
    },
    {
      "table_name": "vertice_connection_records",
      "conname": "vertice_connection_records_categoria_check",
      "definition": "CHECK ((categoria = ANY (ARRAY['academico_agregado'::text, 'academico_nominal'::text, 'pessoal'::text, 'financeiro'::text])))"
    },
    {
      "table_name": "vertice_connection_records",
      "conname": "vertice_connection_records_connection_id_dataset_row_hash_key",
      "definition": "UNIQUE (connection_id, dataset, row_hash)"
    },
    {
      "table_name": "vertice_connection_records",
      "conname": "vertice_connection_records_connection_id_fkey",
      "definition": "FOREIGN KEY (connection_id) REFERENCES vertice_data_connections(id) ON DELETE CASCADE"
    },
    {
      "table_name": "vertice_connection_records",
      "conname": "vertice_connection_records_pkey",
      "definition": "PRIMARY KEY (id)"
    }
  ],
